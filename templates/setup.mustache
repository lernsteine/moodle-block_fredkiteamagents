{{!
    @template block_fredkiteamagents/setup

    Setup checklist for site administrators.

    Example context (json):
    {
        "intro": "Three steps until the agents take part in your courses.",
        "unreachable": false,
        "steps": [
            {"number": 1, "title": "Activate FredKI", "done": true, "text": "Done.", "url": "", "label": ""},
            {"number": 2, "title": "Package", "done": false, "text": "Upgrade.", "url": "https://example.com", "label": "Packages and licence key", "external": false, "marketplaceurl": "https://marketplace.moodle.com/plugins/block_fredkiteamagents"},
            {"number": 3, "title": "In the course", "done": false, "next": true, "text": "Choose the format.", "url": "", "label": ""}
        ]
    }
}}
<div class="block_fredkiteamagents fta-setup">
    <p class="fta-setup__intro">{{intro}}</p>
    {{#unreachable}}<div class="alert alert-warning">{{#str}}error_unreachable, block_fredkiteamagents{{/str}}</div>{{/unreachable}}
    <ol class="fta-setup__steps">
        {{#steps}}
        <li class="fta-setup__step{{#done}} is-done{{/done}}{{#next}} is-next{{/next}}">
            <span class="fta-setup__mark" aria-hidden="true">{{#done}}✓{{/done}}{{^done}}{{number}}{{/done}}</span>
            <div class="fta-setup__body">
                <h3>{{title}}{{#done}} <span class="sr-only visually-hidden">({{#str}}setup_done, block_fredkiteamagents{{/str}})</span>{{/done}}</h3>
                <p>{{{text}}}</p>
                {{#url}}<a class="btn btn-primary" href="{{url}}"{{#external}} target="_blank" rel="noopener"{{/external}}>{{label}}</a>{{/url}}
                {{#marketplaceurl}}<a class="btn btn-link" href="{{marketplaceurl}}" target="_blank" rel="noopener">{{#str}}setup_marketplace, block_fredkiteamagents{{/str}}</a>{{/marketplaceurl}}
            </div>
        </li>
        {{/steps}}
    </ol>
</div>
